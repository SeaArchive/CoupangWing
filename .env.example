PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
DATA_DIR=./data
# Node's crypto.randomBytes(32).toString('base64') generates this key.
# Keep it backed up. Changing it makes stored credentials unreadable.
# Local development creates data/master.key if empty; production requires it.
ENCRYPTION_KEY=
ALLOW_REGISTRATION=true
# Set true only behind an HTTPS reverse proxy.
# NODE_ENV=production
